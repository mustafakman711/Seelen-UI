{
    "activeThemes":  [
                         "@default/theme",
                         "@mustafakman711/macos"
                     ],
    "performanceMode":  {
                            "default":  "Disabled",
                            "onBattery":  "Minimal",
                            "onEnergySaver":  "Extreme"
                        },
    "hardwareAcceleration":  true,
    "pollingInterval":  5,
    "backupSyncEnabled":  false,
