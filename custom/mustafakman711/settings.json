                                               },
                     "@seelen/flyouts":  {
                                             "enabled":  false
                                         },
                     "@seelen/bluetooth-popup":  {
                                                     "enabled":  false
                                                 },
                     "@seelen/keyboard-selector":  {
                                                       "enabled":  false
                                                   },
                     "@seelen/weg-preview":  {
                                                 "enabled":  false
                                             },
                     "@seelen/notifications":  {
                                                   "enabled":  false
                                               }
                 }
